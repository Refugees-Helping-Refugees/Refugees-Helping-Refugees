# Copy this file to .env and fill in real values.
# Generate strong passwords with: openssl rand -base64 24
# .env itself is gitignored — never commit real secrets.

MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=changeme

# The Cloudflare Tunnel hostname editors use to reach wp-admin.
EDIT_HOSTNAME=edit.rhrroc.org

# Absolute path on the Pi where WP2Static writes its static export.
# Must match the "target path" configured in Settings > WP2Static > Deploy.
WP2STATIC_EXPORT_DIR=/home/hamzah/wp2static-export

# Absolute path to the cloudflared credentials directory created by
# `cloudflared tunnel login` / `cloudflared tunnel create` (usually ~/.cloudflared,
# but Docker Compose does not expand "~" so write the real absolute path here,
# e.g. /home/hamzah/.cloudflared).
CLOUDFLARED_CREDS_DIR=/home/hamzah/.cloudflared
